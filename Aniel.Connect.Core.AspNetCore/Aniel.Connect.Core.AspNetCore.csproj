<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netcoreapp3.1</TargetFramework>
	</PropertyGroup>

	<Target Name="CopiarContent" AfterTargets="Build">
		<Message Text="Aniel.Connect.Core.AspNetCore ----------------------&gt; Copiando arquivos da pasta Content" Importance="High" />

		<ItemGroup>
			 <!--Because this ItemGroup is inside the target, this will enumerate
                 all files just before calling Copy. If the ItemGroup were outside
                 the target , it would enumerate the files during evaluation, before
                 the build starts, which may miss files created during the build.--> 
			<Content Include="$(TargetDir)\Content\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(Content)" DestinationFolder="..\..\AnielPontoEletronico\dotnetcore\Aniel.PontoEletronico.AspNetCore\wwwroot\core\content\%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(Content)" DestinationFolder="..\..\Aniel.PortalGestaoRede\Aniel.PortalGestaoRede\wwwroot\core\content\%(RecursiveDir)" SkipUnchangedFiles="true" />

		<Message Text="Aniel.Connect.Core.AspNetCore ----------------------&gt; Arquivos de content copiados" Importance="High" />
	</Target>
	
	<Target Name="CopiarScripts" AfterTargets="Build">
		<Message Text="Aniel.Connect.Core.AspNetCore ----------------------&gt; Copiando arquivos da pasta Scripts" Importance="High" />

		<ItemGroup>
			<!-- Because this ItemGroup is inside the target, this will enumerate
                 all files just before calling Copy. If the ItemGroup were outside
                 the target , it would enumerate the files during evaluation, before
                 the build starts, which may miss files created during the build. -->
			<Scripts Include="$(TargetDir)\Scripts\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(Scripts)" DestinationFolder="..\..\AnielPontoEletronico\dotnetcore\Aniel.PontoEletronico.AspNetCore\wwwroot\core\scripts\%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(Scripts)" DestinationFolder="..\..\Aniel.PortalGestaoRede\Aniel.PortalGestaoRede\wwwroot\core\scripts\%(RecursiveDir)" SkipUnchangedFiles="true" />

		<Message Text="Aniel.Connect.Core.AspNetCore ----------------------&gt; Arquivos de script copiados" Importance="High" />
	</Target>

